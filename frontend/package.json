{
    "name": "resmed-myair-sleep-card",
    "description": "The dashboard card that comes with the ResMed myAir Sleep integration, for a CPAP's nights and the bedroom's conditions",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "lovelace",
        "custom-cards",
        "cpap",
        "resmed",
        "myair",
        "sleep"
    ],
    "type": "module",
    "private": true,
    "license": "MIT",
    "repository": "git@github.com:jesmak/resmed_myair_sleep.git",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write . ../README.md",
        "format:check": "prettier --check . ../README.md",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
